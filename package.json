{
  "name": "testcabinet.ai-repository",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "spell": "cspell lint --no-progress --cache",
    "dev": "npm run dev --workspace apps/site",
    "preview": "npm run preview --workspace apps/site",
    "screenshot": "npm run screenshot --workspace apps/site --",
    "capture-backdrop": "npm run capture-backdrop --workspace apps/site",
    "lint": "eslint --config eslint.config.js --pass-on-unpruned-suppressions .",
    "lint:baseline": "rm -f eslint-suppressions.json && eslint --config eslint.config.js --suppress-all .",
    "lint:prune": "eslint --config eslint.config.js --prune-suppressions ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "cspell": "10.2.2",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "75.0.0",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.8.4",
    "typescript": "^6",
    "typescript-eslint": "8.70.0"
  }
}
